== select_distinct_on_joins
*ast.SelectStatement "SELECT"
  *ast.Identifier "a"
  *ast.Identifier "a"
  *ast.Identifier "b"
  *ast.TableReference "t1"
  *ast.JoinClause "INNER JOIN"
    *ast.TableReference "t1"
    *ast.TableReference "t2"
    *ast.BinaryExpression "="
      *ast.Identifier "id"
      *ast.Identifier "id"
  *ast.JoinClause "LEFT JOIN"
    *ast.TableReference "(t1_with_1_joins)"
    *ast.TableReference "d"
      *ast.SelectStatement "SELECT"
        *ast.Identifier "id"
        *ast.TableReference "t3"
    *ast.BinaryExpression "="
      *ast.Identifier "id"
      *ast.Identifier "id"
  *ast.BinaryExpression ">"
    *ast.Identifier "a"
    *ast.LiteralValue "1"
  *ast.Identifier "a"
  *ast.Identifier "b"
  *ast.BinaryExpression ">"
    *ast.FunctionCall "COUNT"
      *ast.Identifier "*"
    *ast.LiteralValue "1"
  *ast.OrderByExpression "ORDER BY"
    *ast.Identifier "a"
== window_aggregate_order
*ast.SelectStatement "SELECT"
  *ast.FunctionCall "SUM"
    *ast.Identifier "x"
    *ast.WindowSpec "WINDOW"
      *ast.Identifier "g"
      *ast.OrderByExpression "ORDER BY"
        *ast.Identifier "y"
      *ast.WindowFrame "ROWS"
        *ast.WindowFrameBound "PRECEDING"
          *ast.LiteralValue "1"
        *ast.WindowFrameBound "CURRENT ROW"
  *ast.FunctionCall "STRING_AGG"
    *ast.Identifier "n"
    *ast.LiteralValue ","
    *ast.OrderByExpression "ORDER BY"
      *ast.Identifier "n"
  *ast.FunctionCall "PERCENTILE_CONT"
    *ast.LiteralValue "0.5"
    *ast.OrderByExpression "ORDER BY"
      *ast.Identifier "v"
  *ast.TableReference "t"
  *ast.WindowSpec "WINDOW"
    *ast.Identifier "g"
    *ast.OrderByExpression "ORDER BY"
      *ast.Identifier "y"
== case_expressions
*ast.SelectStatement "SELECT"
  *ast.CaseExpression "CASE"
    *ast.WhenClause "WHEN"
      *ast.BinaryExpression "="
        *ast.Identifier "a"
        *ast.LiteralValue "1"
      *ast.LiteralValue "x"
    *ast.WhenClause "WHEN"
      *ast.BinaryExpression "="
        *ast.Identifier "a"
        *ast.LiteralValue "2"
      *ast.LiteralValue "y"
    *ast.LiteralValue "z"
  *ast.CaseExpression "CASE"
    *ast.Identifier "b"
    *ast.WhenClause "WHEN"
      *ast.LiteralValue "1"
      *ast.LiteralValue "2"
  *ast.TableReference "t"
== cte_union
*ast.SetOperation "UNION"
  *ast.SelectStatement "SELECT"
    *ast.WithClause "WITH"
      *ast.CommonTableExpr "c"
        *ast.SelectStatement "SELECT"
          *ast.AliasedExpression "x"
            *ast.LiteralValue "1"
    *ast.Identifier "x"
    *ast.TableReference "c"
  *ast.SelectStatement "SELECT"
    *ast.LiteralValue "2"
== update_returning
*ast.UpdateStatement "UPDATE"
  *ast.UpdateExpression "="
    *ast.Identifier "a"
    *ast.LiteralValue "1"
  *ast.UpdateExpression "="
    *ast.Identifier "b"
    *ast.BinaryExpression "+"
      *ast.Identifier "b"
      *ast.LiteralValue "1"
  *ast.BinaryExpression "="
    *ast.Identifier "id"
    *ast.LiteralValue "2"
  *ast.Identifier "a"
== delete_returning
*ast.DeleteStatement "DELETE"
  *ast.BinaryExpression "="
    *ast.Identifier "id"
    *ast.LiteralValue "1"
  *ast.Identifier "id"
== insert_on_conflict
*ast.InsertStatement "INSERT"
  *ast.Identifier "a"
  *ast.Identifier "b"
  *ast.LiteralValue "1"
  *ast.LiteralValue "2"
  *ast.LiteralValue "3"
  *ast.LiteralValue "4"
  *ast.Identifier "a"
  *ast.OnConflict "ON CONFLICT"
    *ast.Identifier "a"
    *ast.UpdateExpression "="
      *ast.Identifier "b"
      *ast.Identifier "b"
    *ast.BinaryExpression "<"
      *ast.Identifier "b"
      *ast.LiteralValue "10"
== insert_on_duplicate_key
*ast.InsertStatement "INSERT"
  *ast.Identifier "a"
  *ast.Identifier "b"
  *ast.LiteralValue "1"
  *ast.LiteralValue "2"
  *ast.UpsertClause "ON DUPLICATE KEY UPDATE"
    *ast.UpdateExpression "="
      *ast.Identifier "b"
      *ast.FunctionCall "VALUES"
        *ast.Identifier "b"
    *ast.UpdateExpression "="
      *ast.Identifier "a"
      *ast.BinaryExpression "+"
        *ast.Identifier "a"
        *ast.LiteralValue "1"
== create_table
*ast.CreateTableStatement "CREATE TABLE"
  *ast.ColumnDef "id"
    *ast.ColumnConstraint "PRIMARY KEY"
  *ast.ColumnDef "name"
    *ast.ColumnConstraint "NOT NULL"
    *ast.ColumnConstraint "DEFAULT"
      *ast.LiteralValue "x"
  *ast.TableConstraint "CHECK"
    *ast.BinaryExpression ">"
      *ast.Identifier "id"
      *ast.LiteralValue "0"
== create_index
*ast.CreateIndexStatement "CREATE INDEX"
  *ast.IndexColumn "a"
  *ast.IndexColumn "b"
  *ast.BinaryExpression ">"
    *ast.Identifier "a"
    *ast.LiteralValue "0"
== merge
*ast.MergeStatement "MERGE"
  *ast.TableReference "tgt"
  *ast.TableReference "src"
  *ast.BinaryExpression "="
    *ast.Identifier "id"
    *ast.Identifier "id"
  *ast.MergeWhenClause "WHEN MATCHED"
    *ast.MergeAction "UPDATE"
      *ast.SetClause "t.v"
        *ast.Identifier "v"
  *ast.MergeWhenClause "WHEN NOT_MATCHED"
    *ast.MergeAction "INSERT"
      *ast.Identifier "id"
      *ast.Identifier "v"
== match_recognize
*ast.SelectStatement "SELECT"
  *ast.Identifier "*"
  *ast.TableReference "t"
    *ast.MatchRecognizeClause "MATCH_RECOGNIZE"
      *ast.Identifier "s"
      *ast.OrderByExpression "ORDER BY"
        *ast.Identifier "ts"
      *ast.FunctionCall "MATCH_NUMBER"
      *ast.BinaryExpression ">"
        *ast.Identifier "price"
        *ast.FunctionCall "PREV"
          *ast.Identifier "price"
      *ast.BinaryExpression "<"
        *ast.Identifier "price"
        *ast.FunctionCall "PREV"
          *ast.Identifier "price"
== alter_table
*ast.AlterStatement "ALTER"
  *ast.AlterTableOperation "ALTER TABLE"
    *ast.ColumnDef "c"
