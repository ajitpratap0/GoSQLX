{
  "sql": "SELECT\n  u.name,\n  u.email,\n  COUNT(o.id) AS order_count,\n  SUM(o.total) AS lifetime_value\nFROM users u\nLEFT JOIN orders o ON o.user_id = u.id\nWHERE u.created_at \u003e '2024-01-01'\nGROUP BY u.name, u.email\nHAVING COUNT(o.id) \u003e 5\nORDER BY lifetime_value DESC\nLIMIT 20;",
